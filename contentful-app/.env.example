# Used by the deploy scripts (npm run upload / upsert-actions / set-parameter-definitions)
# and by the local function tester (npm run test:proxy). Not used by the app at runtime.
# Copy to .env and fill in every value. The scripts read this file only; there is no
# fallback to the Contentful CLI's cached login or to AWS CLI profiles.

# Contentful (organization settings > Apps > your app)
CONTENTFUL_ORG_ID=
CONTENTFUL_APP_DEF_ID=
CONTENTFUL_ACCESS_TOKEN=

# AWS values for the local function tester only. In Contentful these live in the
# app's installation parameters (entered on the config screen), not here.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=d1234abcd.cloudfront.net
